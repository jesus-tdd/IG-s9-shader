precision mediump float;uniform vec2 u_resolution;uniform float u_time;float r(vec2 p){return fract(sin(dot(p,vec2(12,78)))*4e4);}float n(vec2 p){vec2 i=floor(p),f=fract(p);f*=f*(3.-2.*f);return mix(mix(r(i),r(i+vec2(1,0)),f.x),mix(r(i+vec2(0,1)),r(i+1.),f.x),f.y);}void main(){vec2 p=(gl_FragCoord.xy*2.-u_resolution)/u_resolution.y;float h=0.,u;for(float i=0.;i<5.;i++){u=fract(u_time/1.3+i*.2)*2.6;h+=max(u-u*u,0.)*4.*exp(-9.*abs(length(p)-u*1.6+.3-n(p*4.-u*1.5)*.4));}gl_FragColor=vec4(h,h*h*.6,h*h*h*.2,1);}